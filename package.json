{
  "name": "hack-the-school",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:visual": "npm run build && playwright test",
    "test:visual:update": "npm run build && playwright test --update-snapshots=all",
    "preview": "vite preview"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.38.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.94.0",
    "typescript": "~7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
